{
  "schema_version": 1,
  "orchestrator": {
    "model": "human-selected-session-model",
    "reasoning_effort": "human-selected-session-effort",
    "applies_to": ["design", "planning", "difficulty classification", "orchestration", "final synthesis"]
  },
  "difficulty": {
    "low": "Localized, reversible implementation with clear behavior, no security or public-contract change, and focused validation.",
    "medium": "Non-trivial multi-file implementation, meaningful behavioral tradeoffs, or integration work without high-risk architecture or irreversible effects.",
    "high": "Architecture, security boundary, public API or data contract, migration, concurrency-critical behavior, irreversible action, or broad cross-system change."
  },
  "implementation": {
    "low": {"agent": "implement_low", "model": "gpt-5.6-luna", "reasoning_effort": "low"},
    "medium": {"agent": "implement_medium", "model": "gpt-5.6-luna", "reasoning_effort": "high"},
    "high": {"agent": "implement_high", "model": "gpt-5.6-terra", "reasoning_effort": "high"}
  },
  "review": {
    "low": {"agent": "review_low", "model": "gpt-5.6-terra", "reasoning_effort": "medium"},
    "medium": {"agent": "review_medium", "model": "gpt-5.6-terra", "reasoning_effort": "high"},
    "high": {"agent": "review_high", "model": "gpt-5.6-sol", "reasoning_effort": "high"}
  },
  "fresh_review_context": {
    "required": true,
    "include": ["approved Intent Brief", "success criteria", "actual diff", "test and evidence outputs", "documented assumptions and unknowns"],
    "exclude": ["implementation transcript", "implementer conclusions", "suggested review verdict", "hidden expected findings"]
  },
  "claude": {
    "runtime": "claude-code",
    "agent_definitions": ".claude/agents",
    "orchestrator": {
      "model": "human-selected-session-model",
      "reasoning_effort": "human-selected-session-effort",
      "applies_to": ["design", "planning", "difficulty classification", "orchestration", "final synthesis"]
    },
    "implementation": {
      "low": {"agent": "implement_low", "model": "sonnet"},
      "medium": {"agent": "implement_medium", "model": "sonnet"},
      "high": {"agent": "implement_high", "model": "opus"}
    },
    "review": {
      "low": {"agent": "review_low", "model": "sonnet"},
      "medium": {"agent": "review_medium", "model": "opus"},
      "high": {"agent": "review_high", "model": "opus"}
    },
    "fresh_review_context": {
      "required": true,
      "include": ["approved Intent Brief", "success criteria", "actual diff", "test and evidence outputs", "documented assumptions and unknowns"],
      "exclude": ["implementation transcript", "implementer conclusions", "suggested review verdict", "hidden expected findings"]
    },
    "known_differences_from_codex_contract": [
      "Claude Code subagent definitions pin a model but cannot pin per-agent reasoning effort, so implementation low and medium share one model instead of differing by effort.",
      "Reviewer read-only status comes from an empty write-tool set plus the shared PreToolUse guard, not from a runtime sandbox_mode.",
      "Claude Code cannot launch the OpenAI profiles in the top-level implementation and review blocks and must never claim to have followed them."
    ]
  }
}
