{
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(.agent-safety/**)",
      "Edit(.agents/**)",
      "Edit(.claude/**)",
      "Edit(.codex/**)",
      "Edit(AGENTS.md)",
      "Edit(CLAUDE.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": ["*"]
    },
    "filesystem": {
      "deny": [
        ".agent-safety",
        ".agents",
        ".claude",
        ".codex",
        "AGENTS.md",
        "CLAUDE.md"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.agent-safety/safe-autonomy/scripts/guard_tool.py\"",
            "timeout": 10,
            "statusMessage": "Checking the workspace boundary"
          }
        ]
      }
    ]
  }
}
